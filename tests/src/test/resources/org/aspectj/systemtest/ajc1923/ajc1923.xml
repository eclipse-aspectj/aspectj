			<stdout>
			<line text="one"/>
			<line text="two"/>
			<line text="many"/>
			<line text="lots"/>
			</stdout>
		</run>
	</ajc-test>
	
	<ajc-test dir="bugs1923/gh328" vm="17" title="problem with inline accessor generator for around advice">
